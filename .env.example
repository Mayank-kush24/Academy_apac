# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/academy_db

# Flask Configuration
FLASK_SECRET_KEY=your-flask-secret-key-change-in-production
FLASK_ENV=development

# Google Gemini (AI Studio) — Data Intelligence panel on the dashboard
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model id for dashboard narrative insights (default: gemini-2.0-flash).
# Use an id from Google AI Studio "List models" for generateContent. Names like
# gemini-1.5-flash-002 often return 404 on current APIs; the app falls back to gemini-2.0-flash.
# For stronger synthesis you can try: gemini-2.5-flash (if your key supports it).
GEMINI_DASHBOARD_MODEL=gemini-2.0-flash

# --- Hack2Skill UTS API (Cohort 3 registration + submission sync) ---
# Required for /c/3/import Sync Now
H2S_UTS_API_KEY=
# Optional overrides:
# H2S_UTS_BASE_URL=https://hack2skill.com
# H2S_UTS_EVENT_SLUG=apac-genaiacademy-c3
# H2S_UTS_AUTH_HEADER=Authorization
# H2S_UTS_AUTH_PREFIX=Bearer
# H2S_UTS_TIMEOUT_SEC=120

# Tuning for the AI Insights cache (all optional)
# How long a successful Gemini response is treated as "fresh" before re-asking the model.
# Default 3600s (1h) — dashboard data only changes on import, so longer is fine.
#GEMINI_INSIGHTS_FRESH_TTL_SEC=3600
# How long previously-good Gemini insights stay available to be served as "stale" when the
# API is rate-limited. Default 86400s (24h).
#GEMINI_INSIGHTS_STALE_MAX_AGE_SEC=86400
# After a 429 / RESOURCE_EXHAUSTED, skip Gemini calls for this many seconds. Default 600s.
#GEMINI_INSIGHTS_RATE_LIMIT_COOLDOWN_SEC=600

# --- Hack2skill CDI (portal) — required; app auth is portal cookie only ---
# H2S_CDI_MODULE_ID=your-nginx-slug
# H2S_CDI_JWT_SECRET=same-as-portal-H2S_CDI_JWT_SECRET
# H2S_CDI_REGISTRATION_SECRET=same-as-portal-MODULE_REGISTRATION_SECRET
# H2S_CDI_URL=https://your-portal.example
# H2S_CDI_INTERNAL_URL=http://127.0.0.1:5050
# H2S_CDI_PUBLIC_URL=
# APPLICATION_ROOT=/your-nginx-slug   (must match nginx mount; use trailing path only, e.g. /apacacademy)
# Portal launch URL should be https://your-host/apacacademy/ so users land on home, not /c/1/dashboard on the bare host.
# BASE_URL=http://127.0.0.1:3002
# PORT=3002
# MODULE_NAME=Gen AI Academy APAC
