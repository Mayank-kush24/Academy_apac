# Required: API key from Google AI Studio
GEMINI_API_KEY=

# Model id and system instruction: edit verification_config.py in this folder

# Required: single shared password to open this tool (never commit real values)
IMAGE_VERIFICATION_SECRET=

# Required: Flask session signing key (use a long random string)
FLASK_SECRET_KEY=

# Bind only on loopback so the service is not reachable from other machines
HOST=127.0.0.1
PORT=5055
